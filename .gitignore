.omx/
.superpowers/

# Local generated demos
.tmp-*/
.tmp*/

# Generated runtime packages; keep source generators and tests in git.
scenarios/*
!scenarios/.gitkeep
policies/*
!policies/.gitkeep
experiments/*
!experiments/.gitkeep
