.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

# Local editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

